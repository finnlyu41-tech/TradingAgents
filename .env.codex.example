# Experimental, local/trusted use only. No API keys, relay or automatic API fallback.
# Copy only these settings into your existing .env; do not overwrite other settings.
TRADINGAGENTS_LLM_PROVIDER=codex_cli
TRADINGAGENTS_QUICK_THINK_PROVIDER=codex_cli
TRADINGAGENTS_DEEP_THINK_PROVIDER=codex_cli
TRADINGAGENTS_QUICK_THINK_LLM=codex-default
TRADINGAGENTS_DEEP_THINK_LLM=codex-default
# Clear stale endpoint and API-only generation settings when switching providers.
TRADINGAGENTS_LLM_BACKEND_URL=
TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
TRADINGAGENTS_TEMPERATURE=
TRADINGAGENTS_MAX_TOKENS=
TRADINGAGENTS_LLM_MAX_RETRIES=
TRADINGAGENTS_CODEX_COMMAND=codex
TRADINGAGENTS_CODEX_TIMEOUT=300
TRADINGAGENTS_CODEX_REASONING_EFFORT=medium
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_TOOL_ROUNDS=4
